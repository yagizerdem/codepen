    "jsCode": "const c=document.getElementById(\"c\").getContext(\"2d\");let s=[[5,5],[4,5],[3,5]],d=[1,0],f=[12,6];setInterval(()=>{const h=[(s[0][0]+d[0]+16)%16,(s[0][1]+d[1]+11)%11];s.unshift(h);if(h[0]==f[0]&&h[1]==f[1])f=[Math.random()*16|0,Math.random()*11|0];else s.pop();if(Math.random()<.2)d=d[0]?[0,Math.random()<.5?1:-1]:[Math.random()<.5?1:-1,0];c.clearRect(0,0,240,160);c.fillStyle=\"#f43f5e\";c.fillRect(f[0]*15,f[1]*15,14,14);c.fillStyle=\"#4ade80\";s.forEach(p=>c.fillRect(p[0]*15,p[1]*15,14,14))},120)"
