{
  "name": "@codepen/backend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "cross-env NODE_ENV=development tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "tsc && tsc-alias",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@codepen/shared": "^1.0.0",
    "@codepen/validator": "^1.0.0",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "cross-env": "^10.1.0",
    "express": "^5.3.0",
    "jose": "^6.2.12",
    "mongoose": "^9.11.2",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.9.7",
    "tsx": "^4.23.15"
  }
}
